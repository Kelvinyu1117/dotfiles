# macOS packages, installed by scripts/packages-macos.sh (`brew bundle`).
# Add a line here and re-run ./install.sh to install something new on every Mac.

# Editor + search (Neovim's fuzzy finder uses rg, fd and fzf)
brew "neovim"
brew "ripgrep"
brew "fd"
brew "fzf"

# Git
brew "git"
brew "git-delta"   # readable diffs in git and lazygit
brew "lazygit"

# Terminal workflow
brew "zellij"      # terminal multiplexer (sessions survive disconnects)
brew "zoxide"      # `z proj` jumps to a directory you've visited
brew "eza"         # modern ls
brew "bat"         # cat with syntax highlighting
brew "yazi"        # terminal file manager
brew "jq"

# Shell scripting
brew "shellcheck"
brew "shfmt"

# Toolchains (C/C++ build tools, Rust, Python)
brew "cmake"
brew "ninja"
brew "rustup"
brew "uv"

# Apps and fonts
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
